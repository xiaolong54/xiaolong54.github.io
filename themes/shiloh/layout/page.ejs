<%
// 独立页面：分类总览、标签云、关于（以及将来任何普通页面）
const type = page.type || '';
const brand = theme.brand || {};
const social = theme.social || {};
%>
<% if (type === 'categories') { %>
<section class="container section">
  <div class="page-head reveal">
    <div class="eyebrow">Categories</div>
    <h1 class="h2 page-head__title">分类</h1>
    <p class="lead page-head__desc">共 <%= site.categories.length %> 个分类。</p>
  </div>
  <% if (site.categories.length) { %>
  <div class="category-list reveal">
    <% site.categories.sort('name').forEach(function (cat) { %>
    <a class="card category-card" href="<%= url_for(cat.path) %>">
      <span class="category-card__name"><%= cat.name %></span>
      <span class="category-card__count"><%= cat.posts.length %> 篇文章</span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="lead" style="margin-top: 40px;">还没有分类。</p>
  <% } %>
</section>

<% } else if (type === 'tags') { %>
<section class="container section">
  <div class="page-head reveal">
    <div class="eyebrow">Tags</div>
    <h1 class="h2 page-head__title">标签</h1>
    <p class="lead page-head__desc">共 <%= site.tags.length %> 个标签，点击查看对应的文章。</p>
  </div>
  <% const tags = site.tags.toArray().sort(function (a, b) { return b.posts.length - a.posts.length; }); %>
  <% if (tags.length) { %>
  <div class="cloud reveal">
    <% tags.forEach(function (tag) { %>
    <a class="tag" href="<%= url_for(tag.path) %>"><%= tag.name %><span class="tag__count"><%= tag.posts.length %></span></a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="lead" style="margin-top: 40px;">还没有标签。</p>
  <% } %>
</section>

<% } else { %>
<section class="container section">
  <% if (type === 'about') { %>
  <div class="profile reveal">
    <span class="brand-mark brand-mark--lg"><%= brand.initials || '' %></span>
    <div class="profile__info">
      <div class="eyebrow">About — 关于</div>
      <h1 class="profile__name"><%= brand.name || config.author %></h1>
      <% if (brand.description) { %>
      <p class="lead profile__role"><%= brand.description %></p>
      <% } %>
      <div class="profile__actions">
        <% if (social.github) { %>
        <a class="btn btn--lime btn--lg" href="<%= social.github %>" target="_blank" rel="noopener noreferrer">
          <%- partial('_partial/icon', { name: 'github', size: 16 }) %>GitHub
        </a>
        <% } %>
        <% if (social.rss) { %>
        <a class="btn btn--outline btn--lg" href="<%= url_for(social.rss) %>" target="_blank" rel="noopener noreferrer">
          <%- partial('_partial/icon', { name: 'rss', size: 15 }) %>订阅
        </a>
        <% } %>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="page-head reveal">
    <h1 class="h2 page-head__title" style="margin-top: 0;"><%= page.title %></h1>
  </div>
  <% } %>

  <% if (page.content && page.content.trim()) { %>
  <div class="post-content page-content <%= type === 'about' ? 'page-content--about' : '' %>"><%- page.content %></div>
  <% } %>
</section>
<% } %>